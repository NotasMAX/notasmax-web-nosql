# Copie para .env e substitua os valores locais fictícios. Nunca use credenciais reais neste arquivo.
MONGODB_URI=mongodb://127.0.0.1:27017/NotasMax
JWT_SECRET=replace-with-a-local-secret-value
PORT=5000
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
FRONTEND_URL=http://localhost:5173
ADMIN_CONTACT_EMAIL=admin@example.test

# Opcional para envio de e-mail de recuperação; use secrets reais somente no ambiente local/host.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Em Azure, configure COOKIE_SECURE=true e COOKIE_SAME_SITE=none.
