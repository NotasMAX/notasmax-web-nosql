{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "26.5.1"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --check-coverage --lines 80 node --test test/*.test.js",
    "start": "nodemon ./index.js localhost 5000"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "nodemon": "^3.1.10"
  },
  "c8": {
    "all": true,
    "include": ["**/*.js"],
    "exclude": ["node_modules/**", "test/**", "DB/seed*.js", "coverage/**"],
    "reporter": ["text", "lcov", "json-summary", "html"],
    "reports-dir": "coverage"
  }
}
